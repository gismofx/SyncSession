<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata (shared across Core, Client, Server) -->
    <Version>1.0.0-rc.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>gismofx</Authors>
    <Company>SyncSession</Company>
    <Product>SyncSession</Product>
    <Copyright>Copyright © 2026 Chad Posner (d/b/a CP Engineering)</Copyright>
    <PackageProjectUrl>https://github.com/gismofx/SyncSession</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gismofx/SyncSession</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbol packages for step-into debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Tests and samples are not packaged -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Source Link for debugger integration comes from the .NET SDK itself (built in since SDK 8),
       so it is patched by updating the SDK. The explicit Microsoft.SourceLink.GitHub 8.0.0
       reference was removed because it overrode the SDK's copy with Microsoft.Build.Tasks.Git
       8.0.0 (CVE-2026-62900), for which no patched 8.x package exists. -->


  <!-- Include README in all NuGet packages (PackageReadmeFile declared above) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
