<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SyncSession.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>SyncSession.Client</PackageId>
    <Description>.NET client library for offline-first sync with a SyncSession server. Provides push/pull synchronization, session tracking, and SQLite local storage.</Description>
    <PackageTags>sync;offline-first;synchronization;client;sqlite;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SyncSession.UnitTests" />
    <InternalsVisibleTo Include="SyncSession.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SyncSession.Core/SyncSession.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
