<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SyncSession.Benchmarks</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Pinned here, not in SyncSession.Server: something in this project's graph still resolves
         4.3.0, which carries GHSA-cmhx-cq75-c4mj (High). The Server used to carry this pin, which
         masked it for every project downstream and forced the reference onto consumers; Benchmarks
         is not shipped, so the pin belongs here. -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SyncSession.Core/SyncSession.Core.csproj" />
    <ProjectReference Include="../../src/SyncSession.Server/SyncSession.Server.csproj" />
    <ProjectReference Include="../../src/SyncSession.Client/SyncSession.Client.csproj" />
    <ProjectReference Include="../../samples/SyncSession.Samples.Shared/SyncSession.Samples.Shared.csproj" />
  </ItemGroup>
</Project>
